# Restricted key (rk_test_... or rk_live_...). Never put this in client code.
STRIPE_SECRET_KEY=
# Signing secret from the Stripe webhook endpoint pointed at /api/webhook
STRIPE_WEBHOOK_SECRET=

# Optional. The Vercel Supabase integration already provides
# STORAGE_SUPABASE_URL and STORAGE_SUPABASE_ANON_KEY (also as NEXT_PUBLIC_STORAGE_*).
# The production build reads those names. Leave these blank unless you are running locally.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
